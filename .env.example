# CrickScorer development environment (copy to .env)
# Do not commit real secrets.

POSTGRES_USER=crickscorer
POSTGRES_PASSWORD=crickscorer_dev
POSTGRES_DB=crickscorer
POSTGRES_PORT=5432

# Used by FastAPI / SQLAlchemy / Alembic inside Compose (host = service name `db`).
# Driver: psycopg v3 (`postgresql+psycopg://`).
DATABASE_URL=postgresql+psycopg://crickscorer:crickscorer_dev@db:5432/crickscorer

SERVER_PORT=8000
ADMIN_PORT=5173
VIEWER_PORT=5174

# Optional comma-separated browser origins for Socket.IO + HTTP CORS.
# Defaults: http://localhost:5173,5174 and http://127.0.0.1:5173,5174
# SOCKETIO_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
