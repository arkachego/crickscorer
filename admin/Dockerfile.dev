# Phase 6 — Vite + React Admin development container.

FROM node:22.12.0-bookworm-slim

ENV NODE_ENV=development

WORKDIR /app

RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json* ./
RUN npm install

COPY --chown=node:node . .

EXPOSE 5173

# Install on start so the bind-mounted source stays in sync with lockfile.
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port ${PORT:-5173}"]
